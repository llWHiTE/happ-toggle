{
  "SDKVersion": 3,
  "Name": "Happ Toggle",
  "Version": "1.12.4.0",
  "UUID": "com.llwhite.happtoggle",
  "Author": "Alexey Storozhilov",
  "URL": "https://github.com/llWHiTE",
  "SupportURL": "https://github.com/llWHiTE",
  "Description": "Toggle Happ VPN and test connection speed. Select a test service by key or dial; display VPN status and measured speed on Stream Deck+ and Neo.",
  "Icon": "imgs/plugin",
  "CodePath": "bin/plugin.js",
  "Nodejs": {
    "Version": "20",
    "Debug": "disabled"
  },
  "Category": "Happ Toggle",
  "CategoryIcon": "imgs/category",
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Software": {
    "MinimumVersion": "7.6"
  },
  "Actions": [
    {
      "Name": "Happ VPN",
      "UUID": "com.llwhite.happtoggle.toggle",
      "Icon": "imgs/action",
      "Tooltip": "Toggle Happ VPN and display status. Hold to test connection speed.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/pi.html",
      "States": [
        {
          "Image": "imgs/key",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "Speed Test",
      "UUID": "com.llwhite.happtoggle.speed",
      "Icon": "imgs/action",
      "Tooltip": "Short press starts/cancels a test. Hold the key to cycle services; hold the dial to toggle VPN. Rotate to select a service, tap to toggle VPN. Neo screen displays status and results.",
      "Controllers": [
        "Keypad",
        "Encoder",
        "Neo"
      ],
      "Encoder": {
        "layout": "layouts/speed.json",
        "TriggerDescription": {
          "Push": "Short press: test/cancel; hold: VPN",
          "Rotate": "Select test service",
          "Touch": "Toggle Happ VPN"
        }
      },
      "PropertyInspectorPath": "ui/pi.html",
      "States": [
        {
          "Image": "imgs/key",
          "ShowTitle": false
        }
      ]
    }
  ]
}